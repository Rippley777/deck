    "cytoscape": "^3.31.0",
    "cytoscape-fcose": "^2.2.0",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
