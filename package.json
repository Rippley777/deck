{
  "license": "SEE LICENSE IN LICENSE",
  "name": "deck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "desktop:build": "npm run release",
    "desktop:build:mac": "npm run release -- --target universal-apple-darwin",
    "release": "node scripts/release.mjs",
    "release:archive": "node scripts/release.mjs --archive-only",
    "test:release": "node --test tests/release.test.mjs",
    "api:dev": "tsx watch server/index.ts",
    "api:start": "tsx server/index.ts",
    "api:start:sql": "tsx server/index-mssql.ts",
    "db:migrate": "tsx server/migrate.ts",
    "db:migrate:sql": "tsx server/migrate-mssql.ts",
    "db:cleanup": "tsx server/cleanup.ts",
    "db:cleanup:sql": "tsx server/cleanup-mssql.ts",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "release:desktop": "node scripts/macos-release.mjs",
    "release:mac": "node scripts/macos-release.mjs",
    "release:mac:check": "node scripts/macos-release.mjs --check",
    "release:mac:sign": "node scripts/macos-release.mjs --sign-only",
    "test:macos-release": "node --test scripts/macos-release.test.mjs"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/lora": "^5.2.5",
    "@house-edge/analytics": "file:vendor/house-edge-analytics-0.1.1.tgz",
    "@radix-ui/react-dialog": "^1.1.6",
    "@tauri-apps/api": "^2.3.0",
    "better-auth": "^1.7.6",
    "chrono-node": "^2.8.0",
    "cytoscape": "^3.31.0",
    "cytoscape-fcose": "^2.2.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "kysely": "^0.29.6",
    "lucide-react": "^0.468.0",
    "mssql": "^12.7.2",
    "nodemailer": "^10.0.13",
    "papaparse": "^5.5.2",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.13.0",
    "tarn": "^3.1.2",
    "tedious": "^20.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.0.9",
    "@tauri-apps/cli": "^2.3.0",
    "@types/cytoscape": "^3.21.9",
    "@types/cytoscape-fcose": "^2.2.5",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.3.15",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.6"
  },
  "engines": {
    "node": ">=22"
  }
}
