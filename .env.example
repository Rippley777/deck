# House Edge analytics for the browser version only; native desktop is excluded.
# Public build-time values. Leave key/endpoint empty to disable.
VITE_HOUSE_EDGE_PROJECT=deck
VITE_HOUSE_EDGE_KEY=
VITE_HOUSE_EDGE_ENDPOINT=
# Opt in only with a separate development analytics project.
VITE_HOUSE_EDGE_TRACK_DEVELOPMENT=false

# Enable the authenticated browser portal (leave false for standalone local Deck).
VITE_DECK_PORTAL=false
# Server-only configuration. Never prefix these with VITE_. Node 22+ required.
APP_URL=http://localhost:1432
PORT=3001
DATABASE_URL=postgresql://deck:deck@localhost:5432/deck
BETTER_AUTH_SECRET=
SMTP_URL=smtp://localhost:1025
# Azure Communication Services Email can be used instead of SMTP_URL.
AZURE_COMMUNICATION_CONNECTION_STRING=
MAIL_FROM=Deck <hello@localhost>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY=0
