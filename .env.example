# House Edge analytics for the browser version only; native desktop is excluded.
# Public build-time values. Leave key/endpoint empty to disable.
VITE_HOUSE_EDGE_PROJECT=deck
VITE_HOUSE_EDGE_KEY=
VITE_HOUSE_EDGE_ENDPOINT=
# Opt in only with a separate development analytics project.
VITE_HOUSE_EDGE_TRACK_DEVELOPMENT=false

# Enable optional browser account/sync features. Both builds start locally without an account.
VITE_DECK_PORTAL=false
# Optional public HTTPS portal origin prefilled in desktop Account settings.
VITE_DECK_CLOUD_URL=
# Server-only configuration. Never prefix these with VITE_. Node 22+ required.
APP_URL=http://localhost:1432
PORT=3001
DATABASE_URL=postgresql://deck:deck@localhost:5432/deck
BETTER_AUTH_SECRET=
SMTP_URL=smtp://localhost:1025
# Azure Communication Services Email can be used instead of SMTP_URL.
AZURE_COMMUNICATION_CONNECTION_STRING=
MAIL_FROM=Deck <hello@localhost>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY=0

# Azure SQL alternative. Existing Entra accounts remain supported.
# Set DATABASE_PROVIDER=mssql for api:start:sql and db:migrate:sql.
DATABASE_PROVIDER=postgres
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_DOMAIN=
# Configure SMTP/ACS + MAIL_FROM to enable Deck-managed email/password on either database.
# Configure GOOGLE_CLIENT_ID/SECRET to enable Google on either database.
